# Copy to .env for local development. Never commit the real .env file
# (it is already listed in .gitignore).

RESUME_ENGINE_APP_ENV=development

# Local, controlled storage -- not cloud storage, per MVP storage decision.
RESUME_ENGINE_UPLOAD_STORAGE_DIR=var/uploads
RESUME_ENGINE_SQLITE_DB_PATH=var/db.sqlite3

# Upload validation
RESUME_ENGINE_MAX_UPLOAD_SIZE_MB=10

# Review UI origin(s) allowed to call this API
RESUME_ENGINE_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Set to true only when this API is deployed behind TLS termination.
RESUME_ENGINE_FORCE_HTTPS=false

# Confidence scoring: fields scored below this (0.0-1.0) are flagged for
# recruiter review. Engineering heuristic, not empirically calibrated --
# see docs/architecture.md's "Confidence scoring" section.
RESUME_ENGINE_CONFIDENCE_REVIEW_THRESHOLD=0.6